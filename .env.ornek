# KEP ATLAS GORSEL BOTU - ORNEK .env DOSYASI
#
# Kullanim:
#   1) Bu dosyayi ".env" adiyla kopyalayin:
#        cp .env.ornek .env
#   2) Asagidaki degerleri kendi bilgilerinizle doldurun.
#   3) .env dosyasi ASLA paylasilmaz / depoya eklenmez (.gitignore korur).
#
# Oncelik sirasi: ortam degiskeni > .env > macOS Keychain
# macOS'ta .env yerine Keychain kullanmak daha guvenlidir:
#        python3 kimlik.py --kur

KEP_ATLAS_EMAIL=ornek@eposta.com
KEP_ATLAS_PASSWORD=buraya-sifrenizi-yazin
EXA_API_KEY=buraya-exa-api-anahtarinizi-yazin
